# ===== AI DRAWING TEACHER - Bien moi truong =====
# Copy file nay thanh .env va dien gia tri that.
# File .env KHONG duoc day len GitHub / Render (no se duoc cau hinh rieng).

# API key cua OpenAI (ho tro gpt-4o / gpt-4o-mini vision).
# Lay tai: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model AI su dung de phan tich anh va tao giao trinh.
# Goi y: gpt-4o (chat luong cao, vision tot) hoac gpt-4o-mini (re hon).
OPENAI_MODEL=gpt-4o

# Port chay server (Render tu dong dat bien PORT, khong can sua).
PORT=3000

# Gioi han kich thuoc file upload (byte). Mac dinh 8MB.
MAX_FILE_SIZE=8388608

# Thoi gian cho toi da khi goi AI (mili giay).
AI_TIMEOUT_MS=120000
